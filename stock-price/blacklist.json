{
  "version": 7,

  // 代码清单（哪些词是真实代码、热门还是冷门、是否撞英文常用词）在 tickers.json，
  // 由 tools/build-tickers.js 每周自动生成；这里只放需要人工判断的部分。

  // ── excludeCodes: 是真实代码、但在论坛里几乎总是别的意思的词（写成 $X 时仍然识别）──
  // 交易术语、月份、财经/科技缩写、券商银行名、常见英文词等。想放行某个就删掉。
  "excludeCodes": [
    "IPO", "PUT", "CALL", "G", "ZS", "B", "WTF", "CAPEX", "TLDR", "BUY",
    "ARROW", "YTD", "OIL", "YEAR", "BEAT", "HOLD", "TACO", "OPUS", "GPT", "PAY",
    "FLAT", "GAIN", "LEAD", "IRS", "EST", "ROTH", "LOW", "FILL",
    "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC",
    "PDT", "INDEX", "APP",
    "ALL", "ARE", "FOR", "HAS", "NOW", "RUN", "MAN", "WAY", "WELL", "CAN", "OUT",
    "GOOD", "HERE", "HELP", "YOU", "AI",
    "NICE", "IT", "MARK", "PLAY", "PM", "CTO", "CPI", "CUE", "DTE", "ET", "EVEN", "AGI", "API",
    "HIGH",
    "SELL", "SIZE", "LOWER",
    "TMD",
    "STOCK", "BLAH", "BRO", "NRA", "NASA", "HTTPS",
    "BUG",
    "ADR", "BETA", "MEME", "MOAT", "EASY", "ELON", "BILL",
    "EXP",
    // 2026-11 用论坛真实帖子评测后补充：财经缩写
    "EPS", "PEG", "PE", "PB", "NAV", "ETF", "ACH", "KYC", "RSU", "ESPP", "IRA", "CEO", "CFO",
    "DCA", "OTM", "ITM", "ATM", "IV", "DD", "YOY", "QOQ", "EOD", "LLC", "CPA", "SSN", "VC", "PR",
    // 科技缩写
    "LLM", "GPU", "CPU", "SSD", "HBM", "TV", "IP", "PPT", "ERC",
    // 券商、银行、信用卡（多数时候指服务本身）
    "IBKR", "RH", "SOFI", "HSBC", "WF", "CSR",
    // 论坛用语
    "OP", "PS", "LZ", "OK", "LOL", "FOMO", "YOLO", "HODL", "PRE", "TOS", "BBB", "CORP", "MAGA"
  ],

  // ── excludePhrases: 这些短语中的词不会被单独匹配为股票代码 ──
  // 多词金融/日常短语，避免 "cost basis" 里的 COST 被当成股票。
  "excludePhrases": [
    "cost basis",
    "stop loss",
    "take profit",
    "debit card",
    "credit card",
    "vice versa",
    "crude oil",
    "long term",
    "short term",
    "negative cor",
    "positive cor",
    "dot com",
    "dot plot",
    "elon musk",
    "tax bracket",
    "open weight"
  ],

  // ── aliases: 代码的其他写法 → Yahoo Finance 代码（等同代码本身，直接识别）──
  "aliases": {
    "BRKB": "BRK-B",
    "BRKA": "BRK-A",
    "BRK.B": "BRK-B",
    "BRK.A": "BRK-A",
    "SPX": "^GSPC",
    "NDX": "^NDX",
    "WTI": "CL=F"
  },

  // ── nameAliases: 公司名 → Yahoo Finance 代码 ──
  // 公司名常有别的意思（苹果、小米、Google 一下），所以要有上下文证据才识别：
  // 旁边有 股/涨/跌/买/仓/财报 之类、标题里出现过、或本帖写过 $代码。
  // 港股 0700.HK、A 股 600519.SS / 300750.SZ、日股 9984.T、韩股 005930.KS。
  "nameAliases": {
    "NVIDIA": "NVDA", "GOOGLE": "GOOGL", "APPLE": "AAPL", "TESLA": "TSLA", "AMAZON": "AMZN",
    "MICROSOFT": "MSFT", "NETFLIX": "NFLX", "COSTCO": "COST", "INTEL": "INTC", "NIKE": "NKE",
    "TSMC": "TSM", "CISCO": "CSCO", "NOKIA": "NOK", "BOEING": "BA", "DISNEY": "DIS",
    "ORACLE": "ORCL", "BROADCOM": "AVGO", "PALANTIR": "PLTR", "MICRON": "MU", "UNITY": "U",
    "SAMSUNG": "005930.KS", "TENCENT": "0700.HK", "ALIBABA": "BABA", "BERKSHIRE": "BRK-B",

    "英伟达": "NVDA", "辉达": "NVDA", "輝達": "NVDA", "苹果": "AAPL", "蘋果": "AAPL",
    "微软": "MSFT", "微軟": "MSFT", "谷歌": "GOOGL", "亚马逊": "AMZN", "亞馬遜": "AMZN",
    "特斯拉": "TSLA", "台积电": "TSM", "台積電": "TSM", "美光": "MU", "博通": "AVGO",
    "甲骨文": "ORCL", "奈飞": "NFLX", "网飞": "NFLX", "伯克希尔": "BRK-B",
    "好市多": "COST", "开市客": "COST", "英特尔": "INTC", "高通": "QCOM", "阿斯麦": "ASML",
    "腾讯": "0700.HK", "騰訊": "0700.HK", "阿里巴巴": "BABA", "阿里": "BABA", "京东": "JD",
    "拼多多": "PDD", "美团": "3690.HK", "小米": "1810.HK", "比亚迪": "1211.HK", "网易": "NTES",
    "百度": "BIDU", "贵州茅台": "600519.SS", "茅台": "600519.SS", "宁德时代": "300750.SZ",
    "中际旭创": "300308.SZ", "旭创": "300308.SZ", "新易盛": "300502.SZ",
    "三星": "005930.KS", "SK海力士": "000660.KS", "海力士": "000660.KS",
    "丰田": "TM", "索尼": "SONY", "任天堂": "NTDOY", "软银": "9984.T", "軟銀": "9984.T"
  },

  // ── cryptoCodes: 加密货币，Yahoo 自动加 -USD 后缀查询 ──
  "cryptoCodes": [
    "BTC", "ETH", "USDT", "BNB", "SOL", "XRP", "USDC", "DOGE",
    "ADA", "TRX", "AVAX", "DOT", "LINK", "MATIC", "SHIB", "LTC",
    "UNI", "ATOM", "XLM", "ETC", "BCH", "FIL", "APT", "NEAR",
    "AAVE", "ARB", "SUI", "TON", "PEPE", "HYPE",
    "DAI", "PYUSD", "USDG", "FDUSD", "USDE"
  ],

  // ── fiatCodes: 法币，Yahoo 用 CURRENCY=X 格式，显示为 1 USD 兑换价 ──
  "fiatCodes": [
    "USD", "CNY", "EUR", "GBP", "JPY", "KRW", "CAD", "AUD", "CHF", "HKD",
    "TWD", "SGD", "INR", "MXN", "BRL", "THB", "MYR", "PHP", "VND",
    "NZD", "SEK", "DKK", "ZAR", "RUB", "TRY", "PLN", "CZK",
    "ILS", "AED", "SAR", "CNH"
  ],

  // ── futuresCodes: 期货，Yahoo 用 =F 后缀查询 ──
  // 指数期货 / 贵金属 / 能源 / 国债 / 农产品
  "futuresCodes": [
    "ES", "NQ", "YM", "RTY", "VIX",
    "GC", "SI", "HG", "PL", "PA",
    "CL", "NG", "RB", "HO", "BZ",
    "ZB", "ZN", "ZF", "ZT",
    "ZW", "ZC", "ZS", "KC", "SB",
    "CT", "LBS"
  ]
}
